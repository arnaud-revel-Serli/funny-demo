{
  "funny-tool-announcer": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File ./scripts/funny-hook.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
